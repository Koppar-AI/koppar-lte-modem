(version 1)
# JLCPCB published capabilities (jlcpcb.com/capabilities/pcb-capabilities, 2026-09-19).
# Written by Koppar; the project's board minimums hold the rest.

(rule "JLC via hole to hole 0.2"
  (constraint hole_to_hole (min 0.2mm)))
(rule "JLC plated pad hole to hole 0.45"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole'")
  (constraint hole_to_hole (min 0.45mm)))
(rule "JLC plated pad ring 0.15"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint annular_width (min 0.15mm)))
(rule "JLC non-plated hole 0.5"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_size (min 0.5mm)))
(rule "JLC plated pad hole to track 0.28"
  (severity warning)
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Track'")
  (constraint hole_clearance (min 0.28mm)))
(rule "JLC inner layer plated pad hole to copper 0.3"
  (severity warning)
  (layer inner)
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Net != B.Net")
  (constraint hole_clearance (min 0.3mm)))
(rule "JLC non-plated hole to track 0.2"
  (severity warning)
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && B.Type == 'Track'")
  (constraint hole_clearance (min 0.2mm)))
