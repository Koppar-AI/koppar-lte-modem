<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Answering with the Mac's audio: the daemon (a child of the app) opens the microphone. -->
    <key>com.apple.security.device.audio-input</key><true/>
    <!-- The bundled Python's cffi/ctypes callbacks (sounddevice, pyusb) need writable code
         pages under the hardened runtime. Library validation stays on: build.sh signs every
         bundled library with the app's own identity. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
</dict>
</plist>
